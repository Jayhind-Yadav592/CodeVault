# CodeVault Environment Configuration

# Django Core
DJANGO_SECRET_KEY=generate_a_secure_random_string_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_ENVIRONMENT=development

# Database Configuration (PostgreSQL/SQLite)
# Leave DB_NAME empty or set to sqlite3 to use local SQLite database during development
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=codevault_user
DB_PASSWORD=codevault_password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=your_mailtrap_user
EMAIL_HOST_PASSWORD=your_mailtrap_password
EMAIL_USE_TLS=True
EMAIL_FROM_ADDRESS=noreply@codevault.local
